# Configurações da API do WAHA
WAHA_URL=http://localhost:3000
WAHA_SESSION=default

# Porta do servidor Webhook
PORT=8080

# Tempo de espera para o voto (humanização) em milissegundos
VOTE_DELAY_MIN=0
VOTE_DELAY_MAX=500

# Whitelist de Grupos autorizados (separados por vírgula).
# Se deixado em branco, TODOS os grupos estarão autorizados.
TARGET_GROUPS=

# Opção padrão para votar (se não fornecida, vota na primeira opção)
DEFAULT_VOTE=
