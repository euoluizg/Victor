{
  "name": "waha-auto-vote-bot",
  "version": "2.0.0",
  "description": "Bot de votação automática para WhatsApp utilizando a WAHA API (Clean Architecture).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:all": "docker-compose up -d && nodemon src/server.js",
    "stop:all": "docker-compose down"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
